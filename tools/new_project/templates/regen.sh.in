#!/usr/bin/env sh
# Regenerate @DISPLAY_NAME@ using its verified project recipe.
# recomp/generate.toml selects rom_identity.txt and any title hooks.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ENGINE=${SNESRECOMP_ROOT:-$ROOT/snesrecomp}
[ -f "$ENGINE/tools/regen_project.sh" ] || {
  echo "snesrecomp is not initialized; run git submodule update --init --recursive" >&2
  exit 1
}
exec sh "$ENGINE/tools/regen_project.sh" --project-root "$ROOT" "$@"
